{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "jsPlugins": ["./src/index.ts"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist", "fixtures/playground/*/**"],
  "rules": {
    "go-internal/boundaries": "error"
  },
  "env": {
    "builtin": true
  }
}
